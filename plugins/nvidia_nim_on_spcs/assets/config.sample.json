{
  "target_database": "NIMS_DB",
  "target_schema": "NV",
  "warehouse": "NIM_WH",
  "warehouse_size": "XSMALL",
  "owner_role": "SYSADMIN",
  "image_repository": "NIM_IMAGES",
  "build_stage": "NIM_BUILD_CTX",
  "build_pool": "NIM_BUILD_POOL",
  "build_pool_family": "GEN_X64_G2_32",
  "source_registry": "nvcr.io",
  "source_registry_user": "$oauthtoken",
  "ngc_secret": "NGC_API_KEY",
  "registry_pull_rule": "NGC_REGISTRY_PULL",
  "registry_pull_eai": "NGC_REGISTRY_PULL_EAI",
  "registry_pull_hosts": [
    "nvcr.io:443",
    "layers.nvcr.io:443",
    "authn.nvidia.com:443",
    "api.ngc.nvidia.com:443"
  ],
  "runtime_rule": "NIM_RUNTIME_EGRESS",
  "runtime_eai": "NIM_RUNTIME_EAI",
  "runtime_egress_hosts": [
    "api.ngc.nvidia.com:443",
    "xfiles.ngc.nvidia.com:443",
    "authn.nvidia.com:443",
    "huggingface.co:443",
    "cdn-lfs.hf.co:443",
    "cdn-lfs-us-1.hf.co:443",
    "transfer.xethub.hf.co:443"
  ],
  "nims": [
    {
      "key": "genmol",
      "enabled": true,
      "image": "nvcr.io/nim/nvidia/genmol",
      "tag": "2.0",
      "service_name": "NIM_GENMOL_SVC",
      "gpu_pool": "NIM_GENMOL_POOL",
      "gpu_pool_family": "GPU_NV_S",
      "gpu_count": 1,
      "memory_request": "12Gi",
      "memory_limit": "24Gi",
      "port": 8000,
      "health_path": "/v1/health/ready",
      "invoke_path": "/generate",
      "public_endpoint": true,
      "weight_download_note": "~500MB, completes in under 5 seconds",
      "weight_cache": false,
      "weight_cache_size_gi": 20,
      "weight_cache_path": "/opt/nim/.cache",
      "weight_cache_from_snapshot": null,
      "weight_cache_throughput": 750,
      "weight_cache_snapshot_on_delete": true,
      "weight_cache_snapshot_delete_after": "7d",
      "env": {}
    },
    {
      "key": "llama-3-1-8b-instruct",
      "enabled": false,
      "image": "nvcr.io/nim/meta/llama-3.1-8b-instruct",
      "tag": "latest",
      "service_name": "NIM_LLAMA31_8B_SVC",
      "gpu_pool": "NIM_LLAMA_POOL",
      "gpu_pool_family": "GPU_NV_M",
      "gpu_count": 1,
      "memory_request": "32Gi",
      "memory_limit": "64Gi",
      "port": 8000,
      "health_path": "/v1/health/ready",
      "invoke_path": "/v1/chat/completions",
      "public_endpoint": true,
      "weight_download_note": "~16GB, 2-3 minutes on first start",
      "weight_cache": false,
      "weight_cache_size_gi": 60,
      "weight_cache_path": "/opt/nim/.cache",
      "weight_cache_from_snapshot": null,
      "weight_cache_throughput": 750,
      "weight_cache_snapshot_on_delete": true,
      "weight_cache_snapshot_delete_after": "7d",
      "env": {
        "NIM_MAX_MODEL_LEN": "16384"
      }
    }
  ]
}
